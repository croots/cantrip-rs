# Sazh Katzroy's attack trigger targets "target creature", not "creature you control": with Sazh and Bot2's Ornithopter (0/2) on
# the battlefield, Bot1 targets the opponent's, which ends with two +1/+1 counters (a 2/4) while Sazh gets none.

[Bot1 Deck]
Mox Emerald
Mox Ruby
Mox Pearl
Mox Jet
Sazh Katzroy
Island x2
Plains
Aven Sentry
Island x8

[Bot2 Deck]
Ornithopter
Island x16

[Actions]
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Sazh Katzroy.Cast
Bot1.Decline
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Attack(Sazh Katzroy)
Bot1.Target(Bot2.Battlefield.Ornithopter)
[T3 Bot1.Main2]

[Expect]
Bot2.Battlefield.Ornithopter.Counters.PlusOnePlusOne = 2
Bot2.Battlefield.Ornithopter.Power = 2
Bot2.Battlefield.Ornithopter.Toughness = 4
Bot1.Battlefield.Sazh Katzroy.Power = 3
