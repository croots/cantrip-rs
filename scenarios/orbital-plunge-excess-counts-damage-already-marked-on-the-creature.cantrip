? Bot2.Battlefield.Phyrexian Soulgorger.Damage = 6
? Bot1.Battlefield.Lander Token = (absent)
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Orbital Plunge.Cast(Bot2.Battlefield.Phyrexian Soulgorger)
Bot1.Pass
Bot2.Pass

[Expect]
Bot2.Graveyard = Phyrexian Soulgorger; Black Lotus
Bot1.Battlefield.Lander Token.Subtypes = Lander
