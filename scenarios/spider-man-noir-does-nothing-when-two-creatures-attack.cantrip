# Spider-Man Noir: the trigger is for a creature that attacks alone (CR 506.5). Noir and Memnite attack together, so no counter is
# put on either and nothing is surveilled; the stack stays empty.

[Bot1 Deck]
Black Lotus
Mox Jet
Mox Ruby
Spider-Man Noir
Memnite
Swamp x2
Swamp x13

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Black)
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Spider-Man Noir.Cast
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Memnite.Cast
Bot1.Pass
[T5 Bot1.Main1]
Bot1.Attack(Spider-Man Noir > Bot2; Memnite > Bot2)
? Stack.Count = 0

[Expect]
Bot1.Battlefield.Spider-Man Noir.Power = 4
Bot1.Battlefield.Memnite.Power = 1
