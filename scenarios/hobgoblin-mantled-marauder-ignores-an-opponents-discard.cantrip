# Hobgoblin's trigger is "Whenever you discard a card": when Bot2 discards two cards to its own Faithless Looting on turn 2,
# Bot1's Hobgoblin stays 1/2.

[Bot1 Deck]
Mox Ruby
Mox Jet
Hobgoblin, Mantled Marauder
Island x20

[Bot2 Deck]
Mox Ruby
Faithless Looting
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Hobgoblin, Mantled Marauder.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot1.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Faithless Looting.Cast
Bot2.Pass
Bot1.Pass
Bot2.Choose(Island; Island)
Bot2.Pass
Bot1.Pass
? Bot2.Graveyard = Faithless Looting; Island; Island

[Expect]
Bot1.Battlefield.Hobgoblin, Mantled Marauder.Power = 1
