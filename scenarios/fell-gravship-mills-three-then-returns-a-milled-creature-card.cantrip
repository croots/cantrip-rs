# Fell Gravship's enter trigger mills three (Ornithopter, Island, Island) and then returns a creature or Spacecraft card from
# the graveyard as the mill left it: Ornithopter, the only one, goes to the hand and the return is not optional (CR 701.17).

[Bot1 Deck]
Mox Jet
Mox Ruby
Mox Pearl
Fell Gravship
Island x3
Ornithopter
Island x12

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Fell Gravship.Cast
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
! Bot1.Choose()
Bot1.Choose(Ornithopter)

[Expect]
Bot1.Hand = Island; Island; Island; Ornithopter
Bot1.Graveyard = Island; Island
Bot1.Library.Count = 10
