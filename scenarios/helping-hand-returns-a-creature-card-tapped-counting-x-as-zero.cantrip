? Bot1.Graveyard.Count = 3
! Bot1.Hand.Helping Hand.Cast(Bot1.Graveyard.Questing Beast)
Bot1.Battlefield.Plains.Activate
Bot1.Hand.Helping Hand.Cast(Bot1.Graveyard.Jacked Rabbit)
