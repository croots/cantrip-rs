Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Hand.Mountain.Play
Bot1.Attack(Ornithopter > Bot2)
[T3 Bot1.DeclareBlockers]
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Turncoat Kunoichi.Cast(Ability: Sneak)
Bot1.Choose(Ornithopter)
Bot1.Battlefield.Mountain#1.Activate
Bot1.Battlefield.Mountain#2.Activate
Bot1.Hand.Choreographed Sparks.Cast
Bot1.Modes(2)
Bot1.Target(Stack.Turncoat Kunoichi)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]
? Bot2.Life = 14

[Expect]
Bot2.Life = 14
