Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot1.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Raging Goblin.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Extinguisher Battleship.Cast
Bot1.Pass
Bot2.Pass
Bot1.Target(Bot1.Battlefield.Extinguisher Battleship)
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Graveyard = Ornithopter; Extinguisher Battleship; Black Lotus
Bot2.Graveyard = Raging Goblin
Bot2.Battlefield = Mox Ruby
