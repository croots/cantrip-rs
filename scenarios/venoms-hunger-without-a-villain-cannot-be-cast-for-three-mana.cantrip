# Venom's Hunger: with no Villain it costs the full {4}{B}, so Bot1's three Moxen ({B} and two others) cannot pay for it. Bot1's own
# Ornithopter is a legal target and Bot1 has the mana for the discounted cost, so only the missing discount refuses the cast.

[Bot1 Deck]
Mox Jet
Mox Pearl
Mox Ruby
Ornithopter
Venom's Hunger
Plains
Plains
Plains x20

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
! Bot1.Hand.Venom's Hunger.Cast(Bot1.Battlefield.Ornithopter; Mana: short)

[Expect]
Bot1.Battlefield.Ornithopter.Power = 0
Bot1.Hand.Count = 3
Bot1.Life = 20
