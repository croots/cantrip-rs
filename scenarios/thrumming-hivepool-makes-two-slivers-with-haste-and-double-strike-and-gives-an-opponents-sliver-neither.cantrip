Bot2.Battlefield.Mox Jet.Activate
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Hand.Sizzling Changeling.Cast
Bot2.Pass
Bot1.Pass
? Bot2.Battlefield.Sizzling Changeling.Keywords = Changeling
[T3 Bot1.Main1]
? Bot1.Battlefield.Sliver Token#1.Keywords = DoubleStrike; Haste
? Bot1.Battlefield.Sliver Token#2.Keywords = DoubleStrike; Haste
? Bot1.Battlefield.Sliver Token#1.Toughness = 1
? Bot1.Battlefield.Sliver Token#2.Toughness = 1
Bot1.Attack(Sliver Token#1; Sliver Token#2 > Bot2)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 16
Bot1.Battlefield = Mox Jet; Mox Pearl; Mox Ruby; Sliver Token; Sliver Token; Thrumming Hivepool
