# Molecular Modifier is itself "a creature you control": at the beginning of Bot1's combat it targets itself and becomes a 3/2 with
# first strike until end of turn, while Bot1's Memnite stays 1/1 without it.

[Bot1 Deck]
Black Lotus
Memnite
Molecular Modifier
Island x20

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Molecular Modifier.Cast
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
[T3 Bot1.BeginCombat]
Bot1.Target(Bot1.Battlefield.Molecular Modifier)
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Battlefield.Molecular Modifier.Power = 3
Bot1.Battlefield.Molecular Modifier.Toughness = 2
Bot1.Battlefield.Molecular Modifier.Keywords = FirstStrike
Bot1.Battlefield.Memnite.Power = 1
Bot1.Battlefield.Memnite.Keywords = (absent)
