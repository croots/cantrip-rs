# Oreplate Pangolin triggers only for "another artifact you control": Bot2's Mox Ruby and Memnite entering ask Bot1 nothing, with
# Bot1's Mox Pearl untapped and able to pay, and leave the Pangolin a 2/2 with no counters.

[Bot1 Deck]
Mox Ruby
Mox Jet
Mox Pearl
Oreplate Pangolin
Island x21

[Bot2 Deck]
Mox Ruby
Memnite
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Oreplate Pangolin.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot1.Pass
? Stack.Count = 0
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot1.Pass
? Stack.Count = 0

[Expect]
Bot1.Battlefield.Oreplate Pangolin.Power = 2
Bot1.Battlefield.Oreplate Pangolin.Toughness = 2
Bot1.Battlefield.Oreplate Pangolin.Counters.PlusOnePlusOne = (absent)
