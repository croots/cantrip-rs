# Lost in Space on Bot1's own Mox Pearl, an artifact that is not a creature (it is accepted for "artifact or creature"): its owner, Bot1, chooses the bottom
# (Decline) rather than the top, so Bot1 does not draw it again; Bot1 then surveils 1 and keeps the Forest on top (nothing goes to the graveyard), and draws it in turn 5.

[Bot1 Deck]
Mox Sapphire
Mox Pearl
Mox Jet
Mox Ruby
Lost in Space
Island
Island
Island
Forest
Island x11

[Bot2 Deck]
Mountain x20

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lost in Space.Cast(Bot1.Battlefield.Mox Pearl)
Bot1.Pass
Bot2.Pass
Bot1.Decline
Bot1.Arrange(Forest | )
? Bot1.Battlefield.Count = 3
? Bot1.Library.Count = 13
[T5 Bot1.Main1]

[Expect]
Bot1.Graveyard = Lost in Space
Bot1.Hand.Count = 4
Bot1.Hand.Forest.Colors.Count = 0
