# "Up to one" (CR 601.2c): Bot1 chooses no target for the Stalker's enters trigger, so it resolves with nothing exiled and Bot2's Grizzly
# Bears stay where they are.

[Bot1 Deck]
Black Lotus
Mox Pearl
All-Fates Stalker
Island x4
Island x20

[Bot2 Deck]
Mox Emerald
Mox Ruby
Grizzly Bears
Island x4
Island x20

[Actions]
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Emerald.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Grizzly Bears.Cast
[T3 Bot1.Main1]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.All-Fates Stalker.Cast
Bot1.Pass
Bot2.Pass
Bot1.Target()
? Stack.Count = 1
Bot1.Pass
Bot2.Pass
[Bot1.Main2]

[Expect]
Exile.Count = 0
Bot1.Battlefield = All-Fates Stalker; Mox Pearl
Bot2.Battlefield = Grizzly Bears; Mox Emerald; Mox Ruby
Stack.Count = 0
