# Peter Parker's Camera: "{2}, {T}, Remove a film counter ...: Copy target activated or triggered ability you control." Turn 1 Bot1 casts it and keeps Mox Jet and Mox Ruby untapped.
# Turn 2 Bot2 activates Mind Stone's draw ability, which is not Bot1's, so Bot1 can't copy it. Turn 3 Bot1 casts Ancestral Recall (a spell, not an ability) and can't copy that either.

[Bot1 Deck]
Mox Pearl
Mox Jet
Mox Ruby
Mox Sapphire
Peter Parker's Camera
Ancestral Recall
Mox Emerald
Island x13

[Bot2 Deck]
Mox Pearl
Mox Jet
Mox Ruby
Mind Stone
Island x16

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Peter Parker's Camera.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Pearl.Cast
Bot2.Pass
Bot2.Hand.Mox Jet.Cast
Bot2.Pass
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Hand.Mind Stone.Cast
Bot2.Pass
Bot1.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Battlefield.Mind Stone.Activate(Ability: Draw)
Bot2.Pass
! Bot1.Battlefield.Peter Parker's Camera.Activate(Stack.Mind Stone)
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Ancestral Recall.Cast(Bot1)
! Bot1.Battlefield.Peter Parker's Camera.Activate(Stack.Ancestral Recall)
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Battlefield.Peter Parker's Camera.Counters.Film = 3
Bot1.Battlefield.Peter Parker's Camera.Tapped = false
