# Lurking Lizards: "Whenever you cast a spell with mana value 4 or greater": "or greater" is no ceiling, and "you cast" excludes the
# opponent. Turn 1 Bot1 casts Lurking Lizards; turn 2 Bot2 casts Air Elemental ({3}{U}{U}, mana value 5) - its spell,
# so Bot1's Lizards stays a 1/3. Turn 3 Bot1 casts Serra Angel ({3}{W}{W}, mana value 5): the Lizards gets a counter, 2/4.

[Bot1 Deck]
Mox Emerald x2
Mox Pearl x3
Lurking Lizards
Serra Angel
Forest x14

[Bot2 Deck]
Mox Sapphire x5
Air Elemental
Island x14

[Actions]
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Mox Emerald#1.Activate
Bot1.Battlefield.Mox Emerald#2.Activate
Bot1.Hand.Lurking Lizards.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mox Sapphire.Cast
Bot2.Hand.Mox Sapphire.Cast
Bot2.Hand.Mox Sapphire.Cast
Bot2.Hand.Mox Sapphire.Cast
Bot2.Hand.Mox Sapphire.Cast
Bot2.Battlefield.Mox Sapphire#1.Activate
Bot2.Battlefield.Mox Sapphire#2.Activate
Bot2.Battlefield.Mox Sapphire#3.Activate
Bot2.Battlefield.Mox Sapphire#4.Activate
Bot2.Battlefield.Mox Sapphire#5.Activate
Bot2.Hand.Air Elemental.Cast
? Bot1.Battlefield.Lurking Lizards.Power = 1
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Pearl#1.Activate
Bot1.Battlefield.Mox Pearl#2.Activate
Bot1.Battlefield.Mox Pearl#3.Activate
Bot1.Battlefield.Mox Emerald#1.Activate
Bot1.Battlefield.Mox Emerald#2.Activate
Bot1.Hand.Serra Angel.Cast
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Battlefield.Lurking Lizards.Power = 2
Bot1.Battlefield.Lurking Lizards.Toughness = 4
