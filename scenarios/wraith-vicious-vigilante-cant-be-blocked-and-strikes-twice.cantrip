[T3 Bot1.Attackers]
? Bot1.Battlefield.Wraith, Vicious Vigilante.Keywords = CantBeBlocked; DoubleStrike
Bot1.Attack(Wraith, Vicious Vigilante > Bot2; Memnite > Bot2)
! Bot2.Block(Memnite > Wraith, Vicious Vigilante)
Bot2.Block(Memnite > Memnite)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 18
Bot2.Battlefield.Count = 0
Bot1.Battlefield.Count = 4
