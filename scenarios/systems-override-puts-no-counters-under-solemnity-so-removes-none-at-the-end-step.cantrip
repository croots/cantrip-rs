Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Specimen Freighter.Cast
Bot2.Pass
Bot1.Pass
Bot2.Target()
Bot2.Pass
Bot1.Pass
Bot2.Battlefield.Specimen Freighter.Activate(Ability: Station)
Bot2.Choose(Memnite)
Bot2.Pass
Bot1.Pass
? Bot2.Battlefield.Specimen Freighter.Counters.Charge = 1
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Solemnity.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Systems Override.Cast(Bot2.Battlefield.Specimen Freighter)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Specimen Freighter.Counters.Charge = 1
? Bot1.Battlefield.Specimen Freighter.Types = Artifact
? Bot1.Battlefield.Specimen Freighter.Keywords = Haste
? Bot1.Battlefield.Specimen Freighter.Tapped = false
[T3 Bot1.End]
? Bot1.Battlefield.Specimen Freighter.Counters.Charge = 1
? Stack.Count = 0
[T4 Bot2.Main1]

[Expect]
Bot2.Battlefield.Specimen Freighter.Counters.Charge = 1
Bot2.Battlefield.Specimen Freighter.Types = Artifact
