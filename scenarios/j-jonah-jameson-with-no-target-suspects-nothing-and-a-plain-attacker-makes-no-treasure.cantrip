# "Suspect up to one target creature": Bot1 chooses no target, so nothing is suspected, and JJJ attacking on turn 5 without menace makes no Treasure.

[Bot1 Deck]
Mox Ruby
Mox Jet
Mox Emerald
J. Jonah Jameson
Island x20

[Bot2 Deck]
Memnite
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Emerald.Cast
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.J. Jonah Jameson.Cast
Bot1.Pass
Bot2.Pass
Bot1.Target()
Bot1.Pass
