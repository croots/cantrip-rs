# Stegron's Dinosaur Formula says "target creature you control": with only Bot2's Ornithopter in play it is not offered on it (and not at all
# with no creature of Bot1's), and once Bot1 has its own Ornithopter it is offered on that one, Bot2's staying a 0/2 Thopter.

[Bot1 Deck]
Mox Ruby
Mox Jet
Ornithopter
Stegron the Dinosaur Man
Island x3
Island x14

[Bot2 Deck]
Ornithopter
Island x19

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
! Bot1.Hand.Stegron the Dinosaur Man.Activate(Bot2.Battlefield.Ornithopter)
! Bot1.Hand.Stegron the Dinosaur Man.Activate
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Stegron the Dinosaur Man.Activate(Bot1.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Ornithopter.Power = 3
? Bot2.Battlefield.Ornithopter.Power = 0
? Bot2.Battlefield.Ornithopter.Subtypes = Thopter

[Expect]
Bot1.Graveyard = Stegron the Dinosaur Man
