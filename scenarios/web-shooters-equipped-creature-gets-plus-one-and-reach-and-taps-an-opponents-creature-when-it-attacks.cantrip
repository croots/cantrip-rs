# Web-Shooters: "Equipped creature gets +1/+1 and has reach and 'Whenever this creature attacks, tap target creature an opponent controls.'"
# Bot1 casts it and equips its Ornithopter (0/2 flying, so 1/3 with reach, CR 613.4c) on turn 1. Bot2 casts its own Ornithopter on turn 2. When
# Bot1 attacks on turn 3 the granted trigger has Bot2's Ornithopter as its only legal target (Bot1's own is not "an opponent's", CR 115.1), so
# it is chosen on its own and tapped as the ability resolves (CR 701.26a).

[Bot1 Deck]
Web-Shooters
Mox Pearl
Mox Jet
Mox Ruby
Mox Sapphire
Ornithopter
Ornithopter
Plains x20

[Bot2 Deck]
Ornithopter
Island x20

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Web-Shooters.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Web-Shooters.Activate(Ornithopter#1)
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Attack(Ornithopter#1 > Bot2)
[T3 Bot1.Main2]

[Expect]
Bot1.Battlefield.Ornithopter#1.Power = 1
Bot1.Battlefield.Ornithopter#1.Toughness = 3
Bot1.Battlefield.Ornithopter#1.Keywords = Flying; Reach
Bot1.Battlefield.Ornithopter#2.Power = 0
Bot1.Battlefield.Ornithopter#2.Keywords = Flying
Bot2.Battlefield.Ornithopter.Tapped = True
Bot2.Life = 19
Stack.Count = 0
