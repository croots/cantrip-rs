? Bot1.Battlefield.Ornithopter#1.Power = 1
? Bot1.Battlefield.Ornithopter#1.Toughness = 2
[T3 Bot1.Main1]

[Expect]
Bot1.Battlefield.Squire's Lightblade.AttachedTo = Ornithopter
Bot1.Battlefield.Ornithopter#1.Keywords = Flying
Bot1.Battlefield.Ornithopter#1.Power = 1
Bot1.Battlefield.Ornithopter#1.Toughness = 2
Bot2.Battlefield.Ornithopter.Power = 0
Bot1.Battlefield.Ornithopter#2.Power = 0
